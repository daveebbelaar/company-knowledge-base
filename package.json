{
  "name": "company-knowledge-base",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env --test tests/*.test.mjs",
    "sanity:setup": "node --env-file=.env scripts/sanity.mjs setup",
    "sanity:import": "node --env-file=.env scripts/sanity.mjs import",
    "sanity:status": "node --env-file=.env scripts/sanity.mjs status",
    "studio": "sanity dev --host 127.0.0.1 --port 3333",
    "studio:build": "sanity build",
    "test:live": "node --env-file=.env scripts/check-live.mjs",
    "test:chat": "node --env-file=.env scripts/check-chat.mjs"
  },
  "dependencies": {
    "@sanity/client": "8.6.1",
    "fumadocs-core": "16.11.3",
    "fumadocs-ui": "16.11.3",
    "gray-matter": "4.0.3",
    "lucide-react": "^0.468.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sanity": "6.13.2",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@vercel/frameworks": {
      "js-yaml": "^3.15.2",
      "smol-toml": "^1.8.0"
    },
    "@module-federation/dts-plugin": {
      "adm-zip": "^0.6.1"
    },
    "typeid-js": {
      "uuid": "^11.1.1"
    }
  }
}
