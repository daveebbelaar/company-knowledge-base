# Stage 1 works without a Sanity account. Change this before sharing access.
SITE_PASSWORD=change-this-password
# This explicit switch controls pages, people, and search. Adding a token does not switch modes.
CONTENT_SOURCE=local

# Stage 2: use a project from https://www.sanity.io/manage
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=knowledge
# Developer token (recommended for agents) for dataset setup/import. Replace with a Viewer token for the website.
SANITY_API_KEY=
# Keep the API version pinned; the search functions use this version.
SANITY_API_VERSION=2025-02-19

# Optional chat answers: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
